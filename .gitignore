.env
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.coverage
.coverage.*
htmlcov/
*.egg-info/
dist/
build/
.idea/
# Keep .claude/CLAUDE.md, settings.json, and specific team-shared
# hooks/agents/skills; ignore everything else (settings.local.json,
# scheduled_tasks.json, etc. -- personal/local state).
.claude/*
!.claude/CLAUDE.md
!.claude/settings.json
!.claude/hooks/
!.claude/hooks/delegation_reminder.py
!.claude/agents/
!.claude/agents/*.md
!.claude/skills/
!.claude/skills/*.md
.omc/
mullet.yaml
*.orig
*.rej
# Mullet runtime state (decisions log, checkpoints, progress notes)
.mullet/
.mcp.json
# Runtime knowledge engine data (client indices, embeddings, state DBs)
mullet/knowledge/pools/
.ai/
OPEN_SOURCE_AUDIT.md
# Site build artifacts (generated by site/build.sh — copies of repo files)
site/docs/
site/*.md
# Site credentials (generated locally, never commit)
site/.htpasswd

conversation-*.md
