# Mullet Environment Variables
# Copy to .env and fill in the keys you use. .env is git-ignored.
# Variables already set in the shell environment take precedence over .env.

# ── LLM Provider API Keys ────────────────────────────────────────────────────
# You need at least one. Start with Kimi — it's the primary provider.

# Kimi K2 — primary cloud provider, cheap and fast (~£20 to start)
# Get key at: https://platform.kimi.ai
# KIMI_API_KEY=sk-...

# Google Gemini — budget fallback, optional
# GOOGLE_API_KEY=...

# OpenRouter — optional, access to many models via one key
# OPENROUTER_API_KEY=sk-or-...

# Anthropic — NOT needed for most users.
# Mullet uses your Claude Max/Pro subscription via Claude Code, not the API.
# ANTHROPIC_API_KEY=sk-ant-...

# ── Mullet Settings ───────────────────────────────────────────────────────────

# Mode: solo (default) or enterprise
MULLET_MODE=solo

# Enterprise license key (required for MULLET_MODE=enterprise)
# MULLET_LICENSE_KEY=...

# Default knowledge pool to search when no --client specified
# TRAWL_DEFAULT_POOL=mullet-dev

# Knowledge pools directory
# TRAWL_POOLS_DIR=/home/user/mullet-pools

# ── Database ─────────────────────────────────────────────────────────────────

# Enterprise only — default is SQLite at ~/.mullet/mullet.db
# DATABASE_URL=postgresql://mullet:pass@localhost/mullet
