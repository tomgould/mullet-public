# Mullet Environment Variables
# Copy to ~/.config/mullet/.env ($MULLET_CONFIG_DIR/.env if that is set) and
# fill in the keys you use. In a source checkout, a .env next to this file is
# read too, for development; it is git-ignored. Variables already set in the
# shell environment take precedence over both.

# ── LLM Provider API Keys ────────────────────────────────────────────────────
# You need at least one. Start with Kimi — it's the primary provider.

# Kimi K2 — primary cloud provider, cheap and fast (~£20 to start)
# Get key at: https://platform.kimi.ai
# KIMI_API_KEY=sk-...

# Google Gemini — budget fallback, optional
# GOOGLE_API_KEY=...

# OpenRouter — optional, access to many models via one key
# OPENROUTER_API_KEY=sk-or-...

# Anthropic — optional, billed per token. Without it, Anthropic-only work goes
# back to Claude Code (or the official claude CLI), which runs it under your
# Claude subscription. Set it only if you want Mullet to call the Anthropic API.
# ANTHROPIC_API_KEY=sk-ant-...

# ── Mullet Settings ───────────────────────────────────────────────────────────

# Mode: solo (default) or enterprise
MULLET_MODE=solo

# Enterprise license key (required for MULLET_MODE=enterprise)
# MULLET_LICENSE_KEY=...

# Default knowledge pool to search when no --client specified
# TRAWL_DEFAULT_POOL=mullet-dev

# Knowledge pools directory
# TRAWL_POOLS_DIR=/home/user/mullet-pools

# ── Database ─────────────────────────────────────────────────────────────────

# Enterprise only — default is SQLite at ~/.mullet/mullet.db
# DATABASE_URL=postgresql://mullet:pass@localhost/mullet

# ── Delegation ───────────────────────────────────────────────────────────────

# on (default) or off. Off stops Mullet sending work to any model provider:
# mullet_run, mullet_delegate, mullet_swarm, mullet_opencode, CLI task runs and
# mullet serve's chat endpoints reply that delegation is turned off. Trawl
# search, knowledge pools, status and budget keep working.
# MULLET_DELEGATION=off

# ── Personal settings ────────────────────────────────────────────────────────
# All optional. Unset, Mullet behaves the same for everyone.

# on: `mullet init`, `mullet setup-claude` and `mullet autopilot init` write a
# "no Co-Authored-By or other AI attribution in commits" rule into the projects
# they set up. Off (default): projects keep their own commit conventions.
# MULLET_NO_AI_ATTRIBUTION=on

# Your app's URL, sent to OpenRouter as the optional HTTP-Referer attribution
# header. Not sent when unset.
# MULLET_OPENROUTER_REFERER=https://example.com/your-app
