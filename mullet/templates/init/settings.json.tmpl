{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PROJECT_DIR}/.claude/hooks/delegation_reminder.py"
          }
        ],
        "matcher": ""
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd ${CLAUDE_PROJECT_DIR} && python3 -m pytest tests/ --lf --maxfail=3 --tb=line -q --no-header 2>&1 | tail -20"
          }
        ],
        "matcher": "Edit|Write"
      }
    ]
  }
}
